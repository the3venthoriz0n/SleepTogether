From 15822b6e3792228d1579c0f61cc9557df9b41423 Mon Sep 17 00:00:00 2001
From: the3venthoriz0n <11714005+the3venthoriz0n@users.noreply.github.com>
Date: Wed, 11 Nov 2026 16:35:49 -0800
Subject: [PATCH 3/3] ci: build the sleep-time-advance branch to the :sleep
 image tag

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .github/workflows/docker-patched-server.yml | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/docker-patched-server.yml b/.github/workflows/docker-patched-server.yml
index ddeb16be..23fc336d 100644
--- a/.github/workflows/docker-patched-server.yml
+++ b/.github/workflows/docker-patched-server.yml
@@ -1,12 +1,12 @@
 name: Build patched server image
 
-# Builds the server image from this branch and publishes it to GitHub Container Registry
-# (ghcr.io/<owner>/st-reborn-server:patched). amd64 only.
+# Builds branch sleep-time-advance and publishes it to GitHub Container Registry
+# (ghcr.io/<owner>/st-reborn-server:sleep). amd64 only. Never writes the :patched tag.
 on:
   workflow_dispatch:
   push:
     branches:
-      - player-inventory-transfers
+      - sleep-time-advance
 
 permissions:
   contents: read
@@ -48,6 +48,6 @@ jobs:
             GITHUB_ACTIONS=true
             VERSION_OVERRIDE=v1.8.4
           push: true
-          tags: ${{ env.IMAGE }}:patched
+          tags: ${{ env.IMAGE }}:sleep
           cache-from: type=gha
           cache-to: type=gha,mode=max
-- 
