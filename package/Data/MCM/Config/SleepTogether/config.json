{
	"modName": "SleepTogether",
	"displayName": "Sleep Together",
	"minMcmVersion": 9,
	"cursorFillMode": "topToBottom",
	"content": [
		{
			"text": "Shared sleep",
			"type": "header"
		},
		{
			"id": "bEnabled:General",
			"text": "Enable Sleep Together",
			"type": "toggle",
			"help": "Sleep and wake with your party.",
			"valueOptions": {
				"sourceType": "ModSettingBool"
			}
		},
		{
			"id": "iWakeHour:General",
			"text": "Wake hour",
			"type": "slider",
			"help": "Hour the party wakes up (0-23).",
			"valueOptions": {
				"min": 0,
				"max": 23,
				"step": 1,
				"formatString": "{0}:00",
				"sourceType": "ModSettingInt"
			}
		},
		{
			"id": "bUseDefaultWake:General",
			"text": "Default: sleep until wake hour",
			"type": "toggle",
			"help": "On: untouched slider sleeps to wake hour. Off: slider only.",
			"valueOptions": {
				"sourceType": "ModSettingBool"
			}
		},
		{
			"id": "bRestoreStats:General",
			"text": "Restore stats after sleep",
			"type": "toggle",
			"help": "Refill health, magicka, stamina on waking.",
			"valueOptions": {
				"sourceType": "ModSettingBool"
			}
		},
		{
			"text": "General",
			"type": "header"
		},
		{
			"id": "bDebug:General",
			"text": "Debug logging",
			"type": "toggle",
			"help": "Extra detail in SleepTogether.log.",
			"valueOptions": {
				"sourceType": "ModSettingBool"
			}
		}
	]
}
